{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": [
    "src",
    "e2e",
    "scripts/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
